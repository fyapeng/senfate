---
import AppLayout from "../../layouts/AppLayout.astro";
import { rulePresentation, rules } from "../../lib/rules";
export async function getStaticPaths() {
  return (await rules()).map((rule) => ({ params: { id: rule.rule_id } }));
}
const { id } = Astro.params;
const rule = (await rules()).find((item) => item.rule_id === id);
const presentation = rule ? rulePresentation(rule) : undefined;
---
<AppLayout title="规则详情"><section class="page"><p class="eyebrow">{presentation?.school ?? "规则详情"} · {presentation?.phase}</p><h1 class="page-title">{rule?.title ?? "未找到规则"}</h1>{rule && presentation && <><p class="page-summary">{rule.description}</p><div class="grid-two"><section><article class="panel rule-reading"><span class="tag">规则说明</span><h2>何时使用</h2><p>此规则在<strong>{presentation.scope}</strong>层进行<strong>{presentation.phase}</strong>判断；当前状态为“{presentation.status}”。</p><h2>依据与来源</h2><div class="source-list">{presentation.sources.map((source,index)=><article key={index}><span>{source.work}</span>{source.section&&<small>{source.section}</small>}<blockquote>{source.quote||"本规则保留来源锚点，但原文摘录尚未提供。"}</blockquote><em>{source.verification}</em></article>)}</div></article><details class="technical-rule"><summary>查看审计技术信息</summary><p>Rule ID：<code>{rule.rule_id}</code></p><pre class="rule-logic">{JSON.stringify({when:rule.when,actions:rule.actions,review:rule.review},null,2)}</pre></details></section><aside class="panel"><span class="tag">规则适用范围</span><p class="metric">{rule.priority}</p><p class="muted">规则优先级（审计字段）</p><p><strong>适用层</strong><br/>{presentation.scope}</p><p><strong>运行状态</strong><br/>{presentation.status}</p><p><strong>来源条数</strong><br/>{presentation.sources.length}</p></aside></div></>}</section></AppLayout>
