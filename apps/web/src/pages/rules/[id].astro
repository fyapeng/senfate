---
import AppLayout from "../../layouts/AppLayout.astro";
import { rulePresentation, rules } from "../../lib/rules";
export async function getStaticPaths() {
  return (await rules()).map((rule) => ({ params: { id: rule.rule_id } }));
}
const { id } = Astro.params;
const rule = (await rules()).find((item) => item.rule_id === id);
const presentation = rule ? rulePresentation(rule) : undefined;
---
<AppLayout title="规则详情"><section class="page"><p class="eyebrow">{presentation?.school ?? "规则详情"} · {presentation?.phase}</p><h1 class="page-title">{rule?.title ?? "未找到规则"}</h1>{rule && presentation && <><p class="page-summary">{rule.description}</p><div class="grid-two"><section><article class="panel rule-reading"><span class="tag">规则说明</span><h2>适用情形</h2><p>这条规则用于<strong>{presentation.scope}</strong>层的<strong>{presentation.phase}</strong>解读。</p><h2>依据与来源</h2><div class="source-list">{presentation.sources.map((source,index)=><article key={index}><span>{source.work}</span>{source.section&&<small>{source.section}</small>}<blockquote>{source.quote||"本规则已保留出处，原文摘录尚待补充。"}</blockquote><em>{source.verification}</em></article>)}</div></article><details class="technical-rule"><summary>查看规则原文结构</summary><p>这一栏用于核对规则条件与结论写法。</p><pre class="rule-logic">{JSON.stringify({when:rule.when,actions:rule.actions,review:rule.review},null,2)}</pre></details></section><aside class="panel"><span class="tag">规则范围</span><p><strong>适用层</strong><br/>{presentation.scope}</p><p><strong>解读阶段</strong><br/>{presentation.phase}</p><p><strong>来源</strong><br/>{presentation.sources.length} 处</p></aside></div></>}</section></AppLayout>
