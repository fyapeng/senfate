  ],
  "rule_packs": [
    "rules/li_hanchen/w05/li_hanchen.w05_procedure.pack.json",
    "rules/li_hanchen/w05/li_hanchen.w05_relations.pack.json",
    "rules/li_hanchen/w05/li_hanchen.w05_classification.pack.json",
    "rules/li_hanchen/w05/li_hanchen.w05_useful_party.pack.json",
    "rules/li_hanchen/w05/li_hanchen.w05_virtual_real.pack.json",
    "rules/li_hanchen/w05/li_hanchen.w05_transform.pack.json",
    "rules/li_hanchen/w05/li_hanchen.w05_temporal.pack.json",
    "rules/li_hanchen/w05/li_hanchen.w05_kinship.pack.json"
  ],
  "parameters": {
    "strength_policy": "transparent_two_party_evidence",
    "branch_policy": "main_qi_only_with_tomb_climate_exception",
    "classification_policy": "fuyi_cong_transform",
    "temporal_policy": "inherit_natal_classification_luck_annual_first",
    "virtual_real_policy": "22_token_partition",
    "unpublished_modules": "unknown",
    "high_risk_output": "neutralize_or_block"
  },
  "thresholds": {
    "reference_dominance_margin": 2,
    "root_effective_min": 1,
    "twice_restrained_count": 2
  },
  "unknown_policy": "propagate",
  "conflict_policy": "preserve_all",
  "relation_resolution": {
    "candidate_source": "common.relation_candidates",
    "resolvers": [
      "li_hanchen.w05.relation_active",
      "li_hanchen.w05.classification_matches",
      "li_hanchen.w05.transform_matches",
      "li_hanchen.w05.temporal_result"
    ],
    "default_unresolved_status": "unknown"
  },
  "output_policy_id": "safety.neutral_output.w07@2.0.0",
  "notes": [
    "Main source: modern.li_hanchen_ba_zi_yu_ce_zhen_zong.",
    "The author's undisclosed four-character interaction rule, three temporal rules, virtual-real algorithms, Baishen, reverse rules and natal fengshui are not reconstructed.",
    "All 296 W05 rules are active in this release.",
    "v1.8: 325 formal rules; adds effective-support boundaries and token-level override precedence."
  ]
}
