      "produces": [
        "FindingIR",
        "TraceIR"
      ]
    },
    {
      "module_id": "li_hanchen.transform",
      "phase": "school.transform_resolution",
      "enabled": true,
      "depends_on": [
        "li_hanchen.relations",
        "li_hanchen.classification"
      ],
      "produces": [
        "FindingIR",
        "TraceIR"
      ]
    },
    {
      "module_id": "li_hanchen.temporal",
      "phase": "school.temporal_resolution",
      "enabled": true,
      "depends_on": [
        "li_hanchen.useful_party",
        "li_hanchen.virtual_real"
      ],
      "produces": [
        "StateIR",
        "FindingIR",
        "TraceIR"
      ]
    },
    {
      "module_id": "li_hanchen.kinship",
      "phase": "school.kinship_resolution",
      "enabled": true,
      "depends_on": [
        "li_hanchen.temporal"
      ],
      "produces": [
        "FindingIR",
        "TraceIR"
      ]
