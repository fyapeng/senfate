  "namespace": "li_hanchen",
  "status": "production",
  "allowed_namespaces": [
    "common",
    "li_hanchen",
    "safety"
  ],
  "phase_order": [
    "common.input_validation",
    "common.fact_compilation",
    "common.relation_candidates",
    "school.procedure_resolution",
    "school.relation_resolution",
    "school.classification",
    "school.useful_party_resolution",
    "school.virtual_real_resolution",
    "school.transform_resolution",
    "school.temporal_resolution",
    "school.kinship_resolution",
    "school.findings",
    "safety.output"
  ],
  "modules": [
    {
      "module_id": "li_hanchen.procedure",
      "phase": "school.procedure_resolution",
      "enabled": true,
      "depends_on": [
        "common.fact_compilation"
      ],
      "produces": [
        "FactIR",
        "FindingIR",
        "TraceIR"
      ]
    },
    {
      "module_id": "li_hanchen.relations",
      "phase": "school.relation_resolution",
      "enabled": true,
      "depends_on": [
        "common.relation_candidates"
      ],
      "produces": [
        "RelationIR",
        "FindingIR",
        "TraceIR"
      ]
    },
    {
      "module_id": "li_hanchen.classification",
      "phase": "school.classification",
      "enabled": true,
      "depends_on": [
        "li_hanchen.relations"
      ],
      "produces": [
        "FindingIR",
        "TraceIR"
      ]
    },
    {
      "module_id": "li_hanchen.useful_party",
      "phase": "school.useful_party_resolution",
      "enabled": true,
      "depends_on": [
        "li_hanchen.classification"
      ],
      "produces": [
        "FindingIR",
        "TraceIR"
      ]
    },
    {
      "module_id": "li_hanchen.virtual_real",
      "phase": "school.virtual_real_resolution",
      "enabled": true,
