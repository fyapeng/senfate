{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://bazi-rules.local/schemas/neutral-output-ir.schema.json",
  "title":"NeutralOutputIR",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","output_id","chart_id","policy_id","context_prefix","sections","global_disclaimer"],
  "properties":{
    "schema_version":{"$ref":"common.schema.json#/$defs/SemVer"},
    "output_id":{"type":"string"},
    "chart_id":{"type":"string"},
    "policy_id":{"$ref":"common.schema.json#/$defs/VersionedId"},
    "context_prefix":{"type":"string"},
    "sections":{"type":"array","items":{"$ref":"#/$defs/Section"}},
    "global_disclaimer":{"type":"string"},
    "provenance_complete":{"type":"boolean"},
    "raw_source_quotes_included":{"type":"boolean"}
  },
  "$defs":{
    "Section":{
      "type":"object","additionalProperties":false,
      "required":["section_id","topic","status","output_mode","summary","claims","caveats"],
      "properties":{
        "section_id":{"type":"string"},
        "topic":{"$ref":"common.schema.json#/$defs/Namespace"},
        "topic_label":{"type":"string"},
        "status":{"type":"string","enum":["agreement","same_direction_different_reason","mixed","contested","incommensurable","not_applicable","unknown"]},
        "output_mode":{"type":"string","enum":["structural_only","neutralized","historical_only","blocked"]},
        "summary":{"type":"string"},
        "claims":{"type":"array","items":{"$ref":"#/$defs/Claim"}},
        "caveats":{"type":"array","items":{"type":"string"}},
        "blocked_reason_codes":{"type":"array","items":{"type":"string"}}
      }
    },
    "Claim":{
      "type":"object","additionalProperties":false,
      "required":["claim_id","text","school_profile_id","finding_ids","source_rule_ids"],
      "properties":{
        "claim_id":{"type":"string"},
        "text":{"type":"string"},
        "school_profile_id":{"$ref":"common.schema.json#/$defs/VersionedId"},
        "finding_ids":{"type":"array","items":{"type":"string"}},
        "source_rule_ids":{"type":"array","items":{"$ref":"common.schema.json#/$defs/VersionedId"}},
        "evidence_status":{"type":"string","enum":["direct","derived","contested","incomplete","unknown"]}
      }
    }
  }
}
