{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://bazi-rules.local/schemas/school-theme-ir.schema.json",
  "title":"SchoolThemeIR",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","theme_id","school_id","profile_id","chart_id","stage","topic","coverage","stance","headline","conclusion","supporting_factors","limiting_factors","time_effect","source_rule_ids","source_chunk_ids","safety"],
  "properties":{
    "schema_version":{"$ref":"common.schema.json#/$defs/SemVer"},
    "theme_id":{"type":"string","minLength":1},
    "school_id":{"type":"string","minLength":1},
    "profile_id":{"$ref":"common.schema.json#/$defs/VersionedId"},
    "chart_id":{"type":"string","minLength":1},
    "stage":{"$ref":"common.schema.json#/$defs/Stage"},
    "topic":{"type":"string","enum":["personality","learning","wealth","career","relationships"]},
    "coverage":{"type":"string","enum":["full","partial","not_covered"]},
    "stance":{"type":"string","enum":["supportive","mixed","challenging","descriptive"]},
    "headline":{"type":"string","minLength":1},
    "conclusion":{"type":"string","minLength":1},
    "supporting_factors":{"type":"array","items":{"type":"string"}},
    "limiting_factors":{"type":"array","items":{"type":"string"}},
    "time_effect":{"type":["string","null"]},
    "source_rule_ids":{"type":"array","items":{"$ref":"common.schema.json#/$defs/VersionedId"}},
    "source_chunk_ids":{"type":"array","items":{"type":"string"}},
    "safety":{"type":"object","additionalProperties":false,"required":["output_mode","scope"],"properties":{"output_mode":{"type":"string","enum":["structural_only","neutralized","blocked"]},"scope":{"type":"string"}}}
  }
}
