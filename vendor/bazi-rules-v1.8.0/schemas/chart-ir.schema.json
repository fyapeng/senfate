{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi-rules.local/schemas/chart-ir.schema.json",
  "title": "ChartIR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chart_id",
    "pillars",
    "day_master",
    "ten_god_map",
    "luck_cycles"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SemVer"
    },
    "chart_id": {
      "type": "string",
      "minLength": 1
    },
    "pillars": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "day",
        "hour"
      ],
      "properties": {
        "year": {
          "$ref": "#/$defs/Pillar"
        },
        "month": {
          "$ref": "#/$defs/Pillar"
        },
        "day": {
          "$ref": "#/$defs/Pillar"
        },
        "hour": {
          "$ref": "#/$defs/Pillar"
        }
      }
    },
    "day_master": {
      "$ref": "common.schema.json#/$defs/Stem"
    },
    "ten_god_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "甲",
        "乙",
        "丙",
        "丁",
        "戊",
        "己",
        "庚",
        "辛",
        "壬",
        "癸"
      ],
      "properties": {
        "甲": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "乙": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "丙": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "丁": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "戊": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "己": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "庚": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "辛": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "壬": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "癸": {
          "$ref": "common.schema.json#/$defs/TenGod"
        }
      }
    },
    "luck_cycles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LuckCycle"
      }
    },
    "annual_contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnnualContext"
      }
    },
    "traditional_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sex_parameter": {
          "type": "string",
          "enum": [
            "male",
            "female",
            "unspecified"
          ]
        },
        "direction_parameter": {
          "type": "string",
          "enum": [
            "forward",
            "reverse",
            "not_supplied"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "input_boundary"
      ],
      "properties": {
        "input_boundary": {
          "const": "post_charting"
        },
        "provider": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "HiddenStem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stem",
        "role",
        "order"
      ],
      "properties": {
        "stem": {
          "$ref": "common.schema.json#/$defs/Stem"
        },
        "role": {
          "type": "string",
          "enum": [
            "main",
            "middle",
            "residual"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "ten_god": {
          "$ref": "common.schema.json#/$defs/TenGod"
        }
      }
    },
    "Pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stem",
        "branch",
        "hidden_stems"
      ],
      "properties": {
        "stem": {
          "$ref": "common.schema.json#/$defs/Stem"
        },
        "branch": {
          "$ref": "common.schema.json#/$defs/Branch"
        },
        "stem_ten_god": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "hidden_stems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/HiddenStem"
          }
        }
      }
    },
    "LuckCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "luck_cycle_id",
        "order",
        "stem",
        "branch",
        "start_year",
        "end_year"
      ],
      "properties": {
        "luck_cycle_id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "stem": {
          "$ref": "common.schema.json#/$defs/Stem"
        },
        "branch": {
          "$ref": "common.schema.json#/$defs/Branch"
        },
        "start_year": {
          "type": "integer",
          "minimum": 1
        },
        "end_year": {
          "type": "integer",
          "minimum": 1
        },
        "stem_ten_god": {
          "$ref": "common.schema.json#/$defs/TenGod"
        },
        "hidden_stems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HiddenStem"
          }
        }
      }
    },
    "AnnualContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annual_id",
        "year",
        "stem",
        "branch"
      ],
      "properties": {
        "annual_id": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1
        },
        "stem": {
          "$ref": "common.schema.json#/$defs/Stem"
        },
        "branch": {
          "$ref": "common.schema.json#/$defs/Branch"
        },
        "stem_ten_god": {
          "$ref": "common.schema.json#/$defs/TenGod"
        }
      }
    }
  }
}
