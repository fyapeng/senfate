{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi-rules.local/schemas/rule-pack.schema.json",
  "title": "RulePack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "namespace",
    "school_id",
    "label",
    "status",
    "rule_files"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SemVer"
    },
    "pack_id": {
      "$ref": "common.schema.json#/$defs/VersionedId"
    },
    "namespace": {
      "$ref": "common.schema.json#/$defs/Namespace"
    },
    "school_id": {
      "type": "string",
      "enum": [
        "common",
        "classical_ziping",
        "shao_weihua",
        "li_hanchen",
        "duan_li_xiang"
      ]
    },
    "label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sample",
        "provisional",
        "reviewed",
        "production",
        "disabled"
      ]
    },
    "rule_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^rules/.+\\.rule\\.json$"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
