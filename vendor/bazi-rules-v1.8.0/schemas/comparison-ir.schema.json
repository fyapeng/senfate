{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://bazi-rules.local/schemas/comparison-ir.schema.json",
  "title":"ComparisonIR",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","comparison_id","chart_id","topic","status","items"],
  "properties":{
    "schema_version":{"$ref":"common.schema.json#/$defs/SemVer"},
    "comparison_id":{"type":"string"},
    "chart_id":{"type":"string"},
    "topic":{"$ref":"common.schema.json#/$defs/Namespace"},
    "status":{"type":"string","enum":["agreement","same_direction_different_reason","mixed","contested","incommensurable","not_applicable","unknown"]},
    "comparison_basis":{"type":"string","enum":["common_fact","directional_theme","structural_analogy","not_comparable"]},
    "comparability":{"type":"string","enum":["exact","partial","none","unknown"]},
    "items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Item"}},
    "common_fact_ids":{"type":"array","items":{"type":"string"}},
    "input_finding_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "coverage":{"$ref":"#/$defs/Coverage"},
    "safety":{"$ref":"#/$defs/Safety"},
    "reason_codes":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "notes":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{
    "Item":{
      "type":"object","additionalProperties":false,
      "required":["school_profile_id","finding_ids","comparison_role"],
      "properties":{
        "school_profile_id":{"$ref":"common.schema.json#/$defs/VersionedId"},
        "finding_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "comparison_role":{"type":"string","enum":["supports","opposes","mixed","not_applicable","unknown","incommensurable"]},
        "reason_summary":{"type":"string"},
        "reason_families":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "concept_families":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "evidence_statuses":{"type":"array","items":{"type":"string","enum":["direct","derived","contested","incomplete","unknown"]},"uniqueItems":true}
      }
    },
    "Coverage":{
      "type":"object","additionalProperties":false,
      "required":["requested_profile_count","participating_profile_count"],
      "properties":{
        "requested_profile_count":{"type":"integer","minimum":1},
        "participating_profile_count":{"type":"integer","minimum":0},
        "comparable_profile_count":{"type":"integer","minimum":0},
        "unknown_profile_count":{"type":"integer","minimum":0},
        "not_applicable_profile_count":{"type":"integer","minimum":0}
      }
    },
    "Safety":{
      "type":"object","additionalProperties":false,
      "required":["risk_class","output_mode"],
      "properties":{
        "risk_class":{"type":"string","enum":["none","low","financial","status","relationship","personality","health","death","crime"]},
        "output_mode":{"type":"string","enum":["structural_only","neutralized","historical_only","blocked"]},
        "reason_codes":{"type":"array","items":{"type":"string"}}
      }
    }
  }
}
