{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi-rules.local/schemas/rule-ir.schema.json",
  "title": "RuleIR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "title",
    "namespace",
    "school_id",
    "module",
    "status",
    "maturity",
    "enabled",
    "scope",
    "phase",
    "priority",
    "when",
    "unknown_policy",
    "actions",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SemVer"
    },
    "rule_id": {
      "$ref": "common.schema.json#/$defs/VersionedId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "namespace": {
      "$ref": "common.schema.json#/$defs/Namespace"
    },
    "school_id": {
      "type": "string",
      "enum": [
        "common",
        "classical_ziping",
        "shao_weihua",
        "li_hanchen",
        "duan_li_xiang"
      ]
    },
    "module": {
      "$ref": "common.schema.json#/$defs/Namespace"
    },
    "status": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/RuleStatus"
      }
    },
    "maturity": {
      "type": "string",
      "enum": [
        "sample",
        "provisional",
        "reviewed",
        "production"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/Stage"
      }
    },
    "phase": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "priority": {
      "type": "integer",
      "minimum": -10000,
      "maximum": 10000
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "when": {
      "$ref": "#/$defs/Condition"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Exception"
      }
    },
    "unknown_policy": {
      "type": "string",
      "enum": [
        "propagate",
        "skip",
        "fire_as_unknown"
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Action"
      }
    },
    "conflict": {
      "$ref": "#/$defs/Conflict"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "source-ref.schema.json"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "source_checked",
            "logic_checked",
            "approved",
            "blocked"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "const": "literal"
            },
            "value": {
              "$ref": "common.schema.json#/$defs/TruthValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/Condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "operator"
          ],
          "properties": {
            "op": {
              "const": "fact"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "const": "exists"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "operator",
            "value"
          ],
          "properties": {
            "op": {
              "const": "fact"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "type": "string",
              "enum": [
                "equals",
                "not_equals",
                "in",
                "not_in",
                "gt",
                "gte",
                "lt",
                "lte",
                "contains"
              ]
            },
            "value": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "in",
                      "not_in"
                    ]
                  }
                },
                "required": [
                  "operator"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "array"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "relation_type"
          ],
          "properties": {
            "op": {
              "const": "relation_exists"
            },
            "relation_type": {
              "$ref": "common.schema.json#/$defs/Namespace"
            },
            "status": {
              "type": "string",
              "enum": [
                "candidate",
                "accepted",
                "rejected",
                "suppressed",
                "unknown"
              ]
            },
            "participant_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "operator",
            "value"
          ],
          "properties": {
            "op": {
              "const": "count"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "type": "string",
              "enum": [
                "equals",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "resolver"
          ],
          "properties": {
            "op": {
              "const": "resolver"
            },
            "resolver": {
              "$ref": "common.schema.json#/$defs/Namespace"
            },
            "args": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "payload"
          ],
          "properties": {
            "action": {
              "const": "emit_fact"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject",
                "predicate",
                "truth"
              ],
              "properties": {
                "subject": {
                  "oneOf": [
                    {
                      "$ref": "common.schema.json#/$defs/EntityRef"
                    },
                    {
                      "$ref": "#/$defs/PathTemplate"
                    }
                  ]
                },
                "predicate": {
                  "$ref": "common.schema.json#/$defs/Namespace"
                },
                "value": {},
                "truth": {
                  "$ref": "common.schema.json#/$defs/TruthValue"
                },
                "source_type": {
                  "const": "rule_asserted"
                },
                "attributes": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "payload"
          ],
          "properties": {
            "action": {
              "const": "emit_relation"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "relation_type",
                "participants",
                "truth",
                "resolution_status"
              ],
              "properties": {
                "relation_type": {
                  "$ref": "common.schema.json#/$defs/Namespace"
                },
                "participants": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "common.schema.json#/$defs/EntityRef"
                      },
                      {
                        "$ref": "#/$defs/PathTemplate"
                      }
                    ]
                  }
                },
                "truth": {
                  "$ref": "common.schema.json#/$defs/TruthValue"
                },
                "resolution_status": {
                  "type": "string",
                  "enum": [
                    "candidate",
                    "accepted",
                    "rejected",
                    "suppressed",
                    "unknown"
                  ]
                },
                "reason_codes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "attributes": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "payload"
          ],
          "properties": {
            "action": {
              "const": "emit_finding"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "finding_type",
                "topic",
                "proposition",
                "truth",
                "evidence_status",
                "safety"
              ],
              "properties": {
                "finding_type": {
                  "type": "string",
                  "enum": [
                    "structural",
                    "procedural",
                    "semantic",
                    "theme",
                    "safety",
                    "comparison"
                  ]
                },
                "topic": {
                  "$ref": "common.schema.json#/$defs/Namespace"
                },
                "subjects": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "common.schema.json#/$defs/EntityRef"
                      },
                      {
                        "$ref": "#/$defs/PathTemplate"
                      }
                    ]
                  }
                },
                "proposition": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "predicate"
                  ],
                  "properties": {
                    "predicate": {
                      "$ref": "common.schema.json#/$defs/Namespace"
                    },
                    "value": {}
                  }
                },
                "truth": {
                  "$ref": "common.schema.json#/$defs/TruthValue"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "supportive",
                    "inhibitory",
                    "mixed",
                    "neutral",
                    "not_applicable",
                    "unknown"
                  ]
                },
                "evidence_status": {
                  "type": "string",
                  "enum": [
                    "direct",
                    "derived",
                    "contested",
                    "incomplete",
                    "unknown"
                  ]
                },
                "safety": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "risk_level",
                    "output_mode",
                    "reason_codes"
                  ],
                  "properties": {
                    "risk_level": {
                      "type": "string",
                      "enum": [
                        "none",
                        "low",
                        "medium",
                        "high",
                        "prohibited_default"
                      ]
                    },
                    "output_mode": {
                      "type": "string",
                      "enum": [
                        "structural_only",
                        "neutralized",
                        "historical_only",
                        "blocked"
                      ]
                    },
                    "reason_codes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "attributes": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "payload"
          ],
          "properties": {
            "action": {
              "const": "set_state"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "value"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]+$"
                },
                "value": {}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "payload"
          ],
          "properties": {
            "action": {
              "const": "tag_entity"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject",
                "tag"
              ],
              "properties": {
                "subject": {
                  "oneOf": [
                    {
                      "$ref": "common.schema.json#/$defs/EntityRef"
                    },
                    {
                      "$ref": "#/$defs/PathTemplate"
                    }
                  ]
                },
                "tag": {
                  "$ref": "common.schema.json#/$defs/Namespace"
                },
                "value": {},
                "attributes": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "payload"
          ],
          "properties": {
            "action": {
              "const": "require_phase"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase"
              ],
              "properties": {
                "phase": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]+$"
                }
              }
            }
          }
        }
      ]
    },
    "Exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exception_id",
        "when",
        "effect"
      ],
      "properties": {
        "exception_id": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "$ref": "#/$defs/Condition"
        },
        "effect": {
          "type": "string",
          "enum": [
            "skip",
            "downgrade_to_unknown",
            "replace_actions"
          ]
        },
        "replacement_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "note": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source-ref.schema.json"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "replace_actions"
              }
            },
            "required": [
              "effect"
            ]
          },
          "then": {
            "required": [
              "replacement_actions"
            ],
            "properties": {
              "replacement_actions": {
                "minItems": 1
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "replacement_actions"
              ]
            }
          }
        }
      ]
    },
    "Conflict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string"
        },
        "policy": {
          "type": "string",
          "enum": [
            "preserve_all",
            "exclusive_within_profile",
            "ordered_override",
            "manual_review"
          ]
        },
        "mutually_exclusive_with": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/VersionedId"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/VersionedId"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "PathTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$path"
      ],
      "properties": {
        "$path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
